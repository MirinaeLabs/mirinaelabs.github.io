---
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_STORE_URL, localizedPath, productFacts, screenshotPath, siteCopy, SITE_BASE, type Locale } from "../data/product";

interface Props { locale: Locale }
const { locale } = Astro.props;
const isKo = locale === "ko";
const copy = siteCopy[locale];
const page = isKo ? {
  title: "AuroraViewer — Mac에서 이미지를 보고, 고르고, 정리하세요",
  description: "폴더와 압축 파일, RAW, PDF를 한 라이브러리에서 열고 비교·평가·태그·검사·내보내기까지 처리하는 macOS 이미지 뷰어입니다.",
  heroEyebrow: "macOS용 이미지 검토·정리",
  workflowEyebrow: "한곳에서 이어지는 작업",
  libraryEyebrow: "많은 이미지 살펴보기",
  compareEyebrow: "세밀한 비교",
  formatEyebrow: "지원 형식과 내보내기",
  manualEyebrow: "사용 설명서에서 시작하기",
  headline: ["이미지를 여는 순간부터,", "고르는 일까지."],
  intro: "폴더와 압축 파일을 한 라이브러리에 모아 큰 이미지도 편하게 살펴보세요. 비교하고, 별점과 Finder 태그로 정리한 뒤 필요한 이미지만 내보낼 수 있습니다.",
  facts: ["모든 기능 무료", "선택한 파일은 Mac 안에서만 처리", `macOS ${productFacts.minimumMacOS} 이상`],
  heroAlt: "AuroraViewer에서 폴더의 사진을 썸네일로 탐색하고 선택한 이미지를 크게 보는 화면",
  heroCaption: "AuroraViewer 실제 화면 · 라이브러리, 평가 도구, 미니맵",
  workflowTitle: ["열고, 살펴보고, 정리하는 일을", "한곳에서."],
  workflowIntro: "파일을 한 장씩 다시 열거나 검토 결과를 다른 앱으로 옮길 필요가 없습니다. 원본 파일은 제자리에 둔 채 한 라이브러리에서 계속 작업하세요.",
  workflows: [
    ["01 · 열기", "폴더와 압축 파일까지 한 번에", "이미지, 폴더와 하위 폴더, ZIP·RAR·7z를 추가하면 파일을 가져온 위치별로 묶어 보여 줍니다."],
    ["02 · 보기", "이미지마다 알맞은 보기로", "창 크기에 맞추기, 원본 크기로 보기, 200%로 보기, 두 장 보기와 2~4분할 비교를 바로 전환합니다."],
    ["03 · 정리", "고른 이미지를 바로 정리", "별점과 선택/제외, Finder 태그를 남기고 파일을 이동·복사하거나 다른 형식으로 내보냅니다."]
  ],
  libraryTitle: ["많은 이미지에서", "필요한 것만 골라내세요."],
  libraryIntro: "리스트와 썸네일 모드를 오가며 파일명이나 확장자로 검색하고, 촬영일·해상도·별점 등 원하는 기준으로 정렬하세요.",
  libraryBullets: ["별점, 선택/제외, 확장자, Finder 태그, 애니메이션 필터", "선택한 이미지나 검색·필터 결과에 별점과 태그를 한꺼번에 적용", "마지막 작업 실행 취소와 진행 중인 파일 작업 확인"],
  libraryLink: "정리 기능 전체 보기",
  libraryAlt: "AuroraViewer 썸네일 모드에서 사진을 별점과 태그로 검토하는 화면",
  compareTitle: ["차이를 놓치지 않는", "2~4분할 비교."],
  compareIntro: "비교할 이미지를 나란히 놓고 확대 비율과 위치를 맞춰 보세요. 필요한 이미지만 따로 움직여 다른 부분을 볼 수도 있습니다.",
  compareBullets: ["2·3·4분할 화면과 드래그 앤 드롭 배치", "이미지별 또는 동기화된 확대·이동", "현재 선택한 이미지에 바로 별점·선택/제외·Finder 태그 적용"],
  compareLink: "비교 모드 사용법",
  compareAlt: "AuroraViewer 비교 모드에서 두 이미지를 나란히 놓고 동기화해 보는 화면",
  formatTitle: ["사진부터 RAW, 문서,", "압축 파일까지."],
  formatIntro: "변환하기 전에 여러 형식의 파일을 바로 확인하세요. 필요한 이미지는 용도에 맞는 형식과 크기로 내보낼 수 있습니다.",
  formatGroups: [
    ["이미지 · RAW", "JPEG, PNG, TIFF, HEIC, WebP, AVIF, PSD와 주요 카메라 RAW 형식"],
    ["문서 · 압축", "SVG, AI, EPS, PDF와 ZIP, RAR, 7z 안의 지원 이미지"],
    ["형식을 바꿔 내보내기", `${productFacts.exportFormats.join(" · ")} 형식, 자르기·크기 조절·메타데이터 설정`]
  ],
  manualTitle: ["필요한 기능을", "바로 찾아보세요."],
  manualIntro: "처음 파일을 여는 방법부터 비교, 중복 이미지 검토, 내보내기, 단축키와 문제 해결까지 작업 순서대로 정리했습니다.",
  support: "지원 받기"
} : {
  title: "AuroraViewer — View, choose, and organize images on Mac",
  description: "A macOS image viewer that brings folders, RAW, PDF, ZIP, RAR, and 7z into one library for comparison, rating, tagging, inspection, and export.",
  heroEyebrow: "macOS image review & organization",
  workflowEyebrow: "One continuous workflow",
  libraryEyebrow: "Library review",
  compareEyebrow: "Compare closely",
  formatEyebrow: "Broad input, careful output",
  manualEyebrow: "Start with the manual",
  headline: ["From the moment you open it", "to the choice you keep."],
  intro: "Bring folders and archives into one library and move naturally through large images. Compare, rate, add Finder tags, and export only the results you need.",
  facts: ["Every feature is free", "Processes user-selected files on your Mac", `macOS ${productFacts.minimumMacOS} or later`],
  heroAlt: "AuroraViewer showing folder thumbnails beside a large selected image",
  heroCaption: "Actual AuroraViewer interface · library, rating controls, and minimap",
  workflowTitle: ["Open, view, and organize", "in one continuous flow."],
  workflowIntro: "You do not have to reopen files one at a time or move review decisions between tools. The AuroraViewer library keeps source location and working context together.",
  workflows: [
    ["01 · OPEN", "Open sources as they are", "Add images, folders, nested folders, ZIP, RAR, and 7z; supported images are grouped by source."],
    ["02 · REVIEW", "Choose the right view", "Move from Fit to Original Size, 200%, two-page viewing, or two-to-four-slot comparison."],
    ["03 · ORGANIZE", "Turn choices into results", "Use ratings, Pick/Reject, Finder tags, file moves and copies, or converted export for the next step."]
  ],
  libraryTitle: ["Narrow a large library", "without losing your place."],
  libraryIntro: "Move between the list and thumbnail grid, search by file name or extension, and sort by capture date, resolution, rating, and more.",
  libraryBullets: ["Ratings, Pick/Reject, extension, Finder tag, and animation filters", "Batch ratings and tags for a selection or all filtered results", "Undo for recent actions and background file operations"],
  libraryLink: "Explore organization features",
  libraryAlt: "AuroraViewer Thumbnail mode used to review photos with ratings and tags",
  compareTitle: ["A two-to-four-way view", "for differences that matter."],
  compareIntro: "Place candidates in slots and synchronize zoom and pan. Any slot can be made independent when you need a different area.",
  compareBullets: ["Two-, three-, and four-slot layouts with drag-and-drop placement", "Per-slot or synchronized zoom and pan", "Ratings, Pick/Reject, and Finder tags for the active slot"],
  compareLink: "Learn Compare mode",
  compareAlt: "Two images side by side in AuroraViewer Compare mode with synchronized transforms",
  formatTitle: ["Photos, RAW, documents,", "and archives."],
  formatIntro: "Inspect a file before converting it, then export the result with the format and dimensions the next task needs.",
  formatGroups: [
    ["Images · RAW", "JPEG, PNG, TIFF, HEIC, WebP, AVIF, PSD, and major camera RAW formats"],
    ["Documents · Archives", "SVG, AI, EPS, PDF, plus supported images inside ZIP, RAR, and 7z"],
    ["Converted export", `${productFacts.exportFormats.join(" · ")}, with crop, resize, and metadata options`]
  ],
  manualTitle: ["Find the feature you need", "and get back to the image."],
  manualIntro: "The manual follows real tasks from opening files through comparison, duplicate review, export, shortcuts, and troubleshooting.",
  support: "Get support"
};
---

<BaseLayout locale={locale} current="home" title={page.title} description={page.description} structuredData>
  <section class="home-hero">
    <div class="wrap">
      <div class="hero-copy">
        <div class="hero-identity">
          <img src={`${SITE_BASE}/assets/auroraviewer-icon-v2.png`} width="62" height="62" alt={isKo ? "AuroraViewer 앱 아이콘" : "AuroraViewer app icon"} />
          <p><strong>AuroraViewer</strong><span>{copy.version}</span></p>
        </div>
        <p class="eyebrow">{page.heroEyebrow}</p>
        <h1>{page.headline[0]}<br />{page.headline[1]}</h1>
        <p class="lede">{page.intro}</p>
        <div class="button-row">
          <a class="button button--primary" href={APP_STORE_URL}>{copy.appStore}</a>
          <a class="button" href={localizedPath(locale, "manual")}>{copy.manual}</a>
        </div>
      </div>
      <ul class="hero-meta" aria-label={isKo ? "제품 요약" : "Product summary"}>
        {page.facts.map((fact) => <li>{fact}</li>)}
      </ul>
      <figure class="hero-visual">
        <img class="screenshot" src={screenshotPath("viewer", locale)} width="1164" height="709" alt={page.heroAlt} loading="eager" fetchpriority="high" />
        <figcaption class="screenshot-caption">{page.heroCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">{page.workflowEyebrow}</p>
        <h2>{page.workflowTitle[0]}<br />{page.workflowTitle[1]}</h2>
        <p class="lede">{page.workflowIntro}</p>
      </div>
      <div class="editorial-grid">
        {page.workflows.map(([index, title, description]) => (
          <article class="editorial-card">
            <span class="index">{index}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap feature-split">
      <div class="feature-split__copy">
        <p class="eyebrow">{page.libraryEyebrow}</p>
        <h2>{page.libraryTitle[0]}<br />{page.libraryTitle[1]}</h2>
        <p class="lede">{page.libraryIntro}</p>
        <ul>{page.libraryBullets.map((item) => <li>{item}</li>)}</ul>
        <a class="text-link" href={localizedPath(locale, "features")}>{page.libraryLink}</a>
      </div>
      <div class="feature-split__visual">
        <img class="screenshot" src={screenshotPath("library", locale)} width="1164" height="709" alt={page.libraryAlt} loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap feature-split feature-split--reverse">
      <div class="feature-split__visual">
        <img class="screenshot" src={screenshotPath("compare", locale)} width="1164" height="709" alt={page.compareAlt} loading="lazy" />
      </div>
      <div class="feature-split__copy">
        <p class="eyebrow">{page.compareEyebrow}</p>
        <h2>{page.compareTitle[0]}<br />{page.compareTitle[1]}</h2>
        <p class="lede">{page.compareIntro}</p>
        <ul>{page.compareBullets.map((item) => <li>{item}</li>)}</ul>
        <a class="text-link" href={localizedPath(locale, "manual/compare-and-pages")}>{page.compareLink}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">{page.formatEyebrow}</p>
        <h2>{page.formatTitle[0]}<br />{page.formatTitle[1]}</h2>
        <p class="lede">{page.formatIntro}</p>
      </div>
      <div class="format-groups">
        {page.formatGroups.map(([title, description]) => (
          <article class="format-group"><h3>{title}</h3><p>{description}</p></article>
        ))}
      </div>
      <p class="fine-print">{copy.conditionalFormats}</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="reading-wrap">
      <p class="eyebrow">{page.manualEyebrow}</p>
      <h2>{page.manualTitle[0]}<br />{page.manualTitle[1]}</h2>
      <p class="lede">{page.manualIntro}</p>
      <div class="button-row">
        <a class="button button--primary" href={localizedPath(locale, "manual")}>{copy.manual}</a>
        <a class="button" href={localizedPath(locale, "support")}>{page.support}</a>
      </div>
    </div>
  </section>
</BaseLayout>
