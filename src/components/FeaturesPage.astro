---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath, productFacts, screenshotPath, siteCopy, type Locale } from "../data/product";

interface Props { locale: Locale }
const { locale } = Astro.props;
const isKo = locale === "ko";
const copy = siteCopy[locale];

const page = isKo ? {
  title: "AuroraViewer 기능 — 이미지 검토와 정리를 한곳에서",
  description: "폴더·압축·RAW 열기, 대용량 이미지 탐색, 비교, 별점과 Finder 태그, 색상·메타데이터 검사, 중복 찾기와 변환 내보내기를 살펴보세요.",
  headline: ["보는 도구를 넘어,", "고르고 정리하는 뷰어."],
  intro: "AuroraViewer는 원본 파일의 위치를 유지한 채 탐색, 비교, 평가, 태그, 검사와 내보내기를 연결합니다. 아래 기능은 현재 배포 소스와 버전 1.6.3을 기준으로 정리했습니다.",
  groups: [
    ["01 · INPUT", "여러 소스를 한 라이브러리로", "개별 이미지, 여러 폴더와 하위 폴더, ZIP·RAR·7z 안의 이미지를 소스별 그룹으로 엽니다. Finder에서 열기와 드래그 앤 드롭도 지원합니다.", ["이미지·폴더·압축 파일 동시 추가", "그룹 접기·펼치기와 순서 변경", "중복 URL 제거와 숨김 항목 제외"], "open-and-import"],
    ["02 · VIEW", "큰 이미지도 맥락과 세부를 함께", "창 맞춤, 원본 크기, 200%, 비율 유지와 커서 중심 확대를 오가며 전체 구도와 픽셀을 확인합니다.", ["점진적 고해상도 렌더링", "미니맵·히스토그램·픽셀 그리드", "회전, 투명 배경, 안티에일리어싱 설정"], "view-and-zoom"],
    ["03 · FIND", "검색하고 정렬해 빠르게 좁히기", "파일명과 확장자를 검색하고 촬영일·수정일·크기·해상도·별점 등으로 정렬합니다. 여러 필터를 조합할 수 있습니다.", ["별점과 Pick/Reject 필터", "확장자·Finder 태그·애니메이션 필터", "필터 결과를 일괄 작업 범위로 사용"], "sidebar-search-filter"],
    ["04 · REVIEW", "평가와 Finder 태그를 원본 곁에", "0–5점과 Pick/Reject 상태를 기록하고 Finder 태그를 읽고 씁니다. 다중 선택이나 필터 결과에도 한 번에 적용할 수 있습니다.", ["키보드 중심 평가", "Finder 태그 생성·적용·해제", "최근 Aurora 작업 실행 취소"], "rate-tag-organize"],
    ["05 · COMPARE", "후보를 나란히, 필요한 만큼", "2·3·4개 슬롯에 이미지를 배치하고 줌과 팬을 동기화합니다. 만화·스캔에는 두 장 보기와 오른쪽에서 왼쪽 읽기 방향을 사용할 수 있습니다.", ["드래그 앤 드롭 슬롯 배치", "슬롯별 독립 또는 동기화된 이동", "애니메이션 재생과 슬라이드쇼"], "compare-and-pages"],
    ["06 · INSPECT", "색상과 촬영 정보를 더 가까이", "포인터 아래 픽셀의 RGBA·HEX·HSB 값을 확대해 보고, EXIF 오버레이에서 카메라와 촬영 정보를 확인합니다.", ["컬러 인스펙터와 루페", "히스토그램·채널 보기", "JPEG·TIFF·HEIC의 일부 EXIF 필드 편집"], "inspect-color-metadata"],
    ["07 · CLEAN", "비슷한 이미지를 묶어 검토", "파일 해시로 완전 중복을 찾거나 지각 해시와 평균 색으로 유사 이미지를 그룹화합니다. 자동 삭제하지 않고 사용자가 결과를 검토합니다.", ["전체·선택·필터 결과 범위", "유사도 임계값 조절", "그룹별 유지 후보 표시"], "duplicates"],
    ["08 · OUTPUT", "다음 작업에 맞춰 내보내기", "선택한 이미지를 변환하거나 원본을 복사·이동합니다. 자르기, 리사이즈, 품질과 메타데이터 정책을 목적에 맞게 정합니다.", ["PNG·JPEG·TIFF·HEIC·WebP", "픽셀·퍼센트·긴 변·짧은 변 리사이즈", "메타데이터 유지·제거·사용자 선택"], "export-and-metadata"]
  ],
  inspectTitle: ["눈으로 확인하고,", "수치로 다시 확인합니다."],
  inspectIntro: "컬러 인스펙터는 원본 좌표를 따라 픽셀을 확대하고 색상 값을 표시합니다. EXIF 오버레이와 히스토그램을 함께 사용하면 파일을 바꾸지 않고도 필요한 정보를 살펴볼 수 있습니다.",
  inspectAlt: "AuroraViewer 컬러 인스펙터가 이미지 픽셀과 색상 값을 보여 주는 화면",
  libraryAlt: "AuroraViewer 썸네일 모드에서 여러 이미지를 탐색하고 평가하는 화면",
  viewerAlt: "AuroraViewer에서 선택한 이미지를 크게 보고 별점과 Finder 태그를 관리하는 화면",
  compareAlt: "AuroraViewer 비교 모드에서 두 이미지를 나란히 확인하는 화면",
  flowNavLabel: "기능 흐름 바로가기",
  flowLabels: ["탐색", "검토", "비교", "검사", "정리", "내보내기"],
  formatsTitle: "지원 형식",
  formatsIntro: "스캐너가 인식하는 입력 확장자입니다. 실제 표시 결과는 파일 내부 코덱과 macOS 지원에 따라 달라질 수 있습니다.",
  images: "이미지 · RAW · 문서",
  archives: "압축",
  exports: "변환 출력",
  workflowTitle: "설정과 작업 상태도 이어집니다.",
  workflowText: "단축키를 바꾸고, 마우스·렌더링·사이드바 동작을 조정할 수 있습니다. 세션 저장과 복원, 여러 뷰어 창, 현재 파일을 Finder에서 보기와 기본 편집 앱으로 열기도 제공합니다.",
  workflowLink: "설정·세션·창 사용법"
} : {
  title: "AuroraViewer Features — Image review and organization in one place",
  description: "Explore folders, archives, RAW viewing, large-image navigation, comparison, ratings, Finder tags, color and metadata inspection, duplicate review, and converted export.",
  headline: ["More than a viewer:", "choose and organize."],
  intro: "AuroraViewer connects browsing, comparison, ratings, tags, inspection, and export while preserving the source location of your files. These capabilities reflect the current source and version 1.6.3.",
  groups: [
    ["01 · INPUT", "Bring sources into one library", "Open individual images, multiple folders and their subfolders, plus images inside ZIP, RAR, and 7z as source groups. Finder opening and drag and drop are supported.", ["Add images, folders, and archives together", "Collapse, expand, and reorder groups", "Skip hidden items and duplicate URLs"], "open-and-import"],
    ["02 · VIEW", "Keep the whole image and its detail in view", "Move among Fit, Original Size, 200%, Preserve Scale, and pointer-centered zoom to examine composition and individual pixels.", ["Progressive high-resolution rendering", "Minimap, histogram, and pixel grid", "Rotation, transparency backgrounds, and antialiasing"], "view-and-zoom"],
    ["03 · FIND", "Search, sort, and narrow the library", "Search names and extensions, then sort by capture or modified date, size, resolution, rating, and more. Filters can be combined.", ["Rating and Pick/Reject filters", "Extension, Finder tag, and animation filters", "Use filtered results as a batch scope"], "sidebar-search-filter"],
    ["04 · REVIEW", "Keep decisions beside the originals", "Record 0–5 stars and Pick/Reject status, then read and write Finder tags. Apply them to a selection or the current filtered results.", ["Keyboard-first ratings", "Create, apply, and remove Finder tags", "Undo recent Aurora operations"], "rate-tag-organize"],
    ["05 · COMPARE", "Place candidates side by side", "Arrange images in two, three, or four slots and synchronize zoom and pan. For comics and scans, use two-page viewing with right-to-left ordering when needed.", ["Drag-and-drop slot placement", "Independent or synchronized transforms", "Animation playback and slideshows"], "compare-and-pages"],
    ["06 · INSPECT", "Look closer at color and capture data", "Magnify the pixel under the pointer and read RGBA, HEX, and HSB values. Use the EXIF overlay for camera and capture information.", ["Color inspector and loupe", "Histogram and channel views", "Edit selected EXIF fields in JPEG, TIFF, and HEIC"], "inspect-color-metadata"],
    ["07 · CLEAN", "Group duplicate and similar images", "Find exact duplicates by file hash, or group visually similar images with perceptual hash and average color. Nothing is deleted automatically.", ["All, selection, or filtered-result scope", "Adjustable similarity threshold", "Review a suggested keeper in each group"], "duplicates"],
    ["08 · OUTPUT", "Prepare files for the next task", "Convert selected images, or copy and move originals. Choose crop, dimensions, quality, and metadata handling for the intended result.", ["PNG, JPEG, TIFF, HEIC, and WebP", "Pixel, percent, long-edge, and short-edge resizing", "Keep, remove, or select metadata"], "export-and-metadata"]
  ],
  inspectTitle: ["Confirm it by eye,", "then confirm the values."],
  inspectIntro: "The Color Inspector follows source coordinates to magnify a pixel and report its values. Pair it with the EXIF overlay and histogram to inspect information without altering the file.",
  inspectAlt: "AuroraViewer Color Inspector showing magnified pixels and color values",
  libraryAlt: "AuroraViewer Thumbnail mode for browsing and rating a collection of images",
  viewerAlt: "AuroraViewer showing a selected image with rating and Finder tag controls",
  compareAlt: "AuroraViewer Compare mode showing two images side by side",
  flowNavLabel: "Jump to a feature workflow",
  flowLabels: ["Browse", "Review", "Compare", "Inspect", "Organize", "Export"],
  formatsTitle: "Supported formats",
  formatsIntro: "These are the input extensions recognized by the scanner. Actual rendering still depends on file contents and macOS support.",
  images: "Images · RAW · Documents",
  archives: "Archives",
  exports: "Converted output",
  workflowTitle: "Settings and working state carry forward, too.",
  workflowText: "Customize shortcuts and mouse, rendering, and sidebar behavior. Save and restore sessions, work with multiple viewer windows, reveal the current file in Finder, or open it in the default editor.",
  workflowLink: "Learn settings, sessions, and windows"
};
const featureGroups = page.groups as Array<[string, string, string, string[], string]>;
const [input, view, find, review, compare, inspect, organize, output] = featureGroups;
---

<BaseLayout locale={locale} current="features" title={page.title} description={page.description} path="features">
  <header class="page-hero"><div class="wrap">
    <p class="eyebrow">Product capabilities</p>
    <h1>{page.headline[0]}<br />{page.headline[1]}</h1>
    <p class="lede">{page.intro}</p>
  </div></header>

  <nav class="feature-flow-nav" aria-label={page.flowNavLabel}>
    <div class="wrap">
      {page.flowLabels.map((label, index) => <a href={`#${["browse", "review", "compare", "inspect", "organize", "export"][index]}`}><span>{String(index + 1).padStart(2, "0")}</span>{label}</a>)}
    </div>
  </nav>

  <section class="product-section" id="browse"><div class="wrap product-story">
    <div class="product-story__copy">
      <p class="eyebrow">Browse</p>
      <h2>{input[1]}</h2><p class="lede">{input[2]}</p>
      <ul class="feature-list">{input[3].map((item) => <li>{item}</li>)}</ul>
      <a class="text-link" href={localizedPath(locale, `manual/${input[4]}`)}>{copy.readMore}</a>
      <div class="story-details">
        {[view, find].map((group) => <article><h3>{group[1]}</h3><p>{group[2]}</p><a href={localizedPath(locale, `manual/${group[4]}`)}>{copy.readMore}</a></article>)}
      </div>
    </div>
    <figure class="product-story__visual"><img class="screenshot" src={screenshotPath("library", locale)} width="1164" height="709" alt={page.libraryAlt} loading="eager" /></figure>
  </div></section>

  <section class="product-section section--tint" id="review"><div class="wrap product-story product-story--reverse">
    <figure class="product-story__visual"><img class="screenshot" src={screenshotPath("viewer", locale)} width="1164" height="709" alt={page.viewerAlt} loading="lazy" /></figure>
    <div class="product-story__copy">
      <p class="eyebrow">Review</p><h2>{review[1]}</h2><p class="lede">{review[2]}</p>
      <ul class="feature-list">{review[3].map((item) => <li>{item}</li>)}</ul>
      <a class="text-link" href={localizedPath(locale, `manual/${review[4]}`)}>{copy.readMore}</a>
    </div>
  </div></section>

  <section class="product-section" id="compare"><div class="wrap product-story">
    <div class="product-story__copy">
      <p class="eyebrow">Compare</p><h2>{compare[1]}</h2><p class="lede">{compare[2]}</p>
      <ul class="feature-list">{compare[3].map((item) => <li>{item}</li>)}</ul>
      <a class="text-link" href={localizedPath(locale, `manual/${compare[4]}`)}>{copy.readMore}</a>
    </div>
    <figure class="product-story__visual"><img class="screenshot" src={screenshotPath("compare", locale)} width="1164" height="709" alt={page.compareAlt} loading="lazy" /></figure>
  </div></section>

  <section class="product-section section--tint" id="inspect"><div class="wrap product-story product-story--reverse">
    <figure class="product-story__visual"><img class="screenshot" src={screenshotPath("inspect", locale)} width="1164" height="709" alt={page.inspectAlt} loading="lazy" /></figure>
    <div class="product-story__copy">
      <p class="eyebrow">Inspect</p><h2>{inspect[1]}</h2><p class="lede">{inspect[2]}</p>
      <ul class="feature-list">{inspect[3].map((item) => <li>{item}</li>)}</ul>
      <a class="text-link" href={localizedPath(locale, `manual/${inspect[4]}`)}>{copy.readMore}</a>
    </div>
  </div></section>

  <section class="product-section" id="organize"><div class="wrap product-duo">
    {[organize, output].map((group, index) => <article id={index === 1 ? "export" : undefined}>
      <p class="eyebrow">{index === 0 ? "Organize" : "Export"}</p><h2>{group[1]}</h2><p class="lede">{group[2]}</p>
      <ul class="feature-list">{group[3].map((item) => <li>{item}</li>)}</ul>
      <a class="text-link" href={localizedPath(locale, `manual/${group[4]}`)}>{copy.readMore}</a>
    </article>)}
  </div></section>

  <section class="product-section product-section--formats section--tint"><div class="wrap">
    <div class="section-heading"><p class="eyebrow">Formats</p><h2>{page.formatsTitle}</h2><p class="lede">{page.formatsIntro}</p></div>
    <div class="format-groups">
      <article class="format-group"><h3>{page.images}</h3><p>{productFacts.imageFormats.join(" · ")}</p></article>
      <article class="format-group"><h3>{page.archives}</h3><p>{productFacts.archiveFormats.join(" · ")}</p></article>
      <article class="format-group"><h3>{page.exports}</h3><p>{productFacts.exportFormats.join(" · ")}</p></article>
    </div>
    <p class="fine-print">{copy.conditionalFormats}</p>
  </div></section>

  <section class="product-section"><div class="reading-wrap">
    <p class="eyebrow">Workspace continuity</p><h2>{page.workflowTitle}</h2><p class="lede">{page.workflowText}</p>
    <a class="text-link" href={localizedPath(locale, "manual/settings-sessions-windows")}>{page.workflowLink}</a>
  </div></section>
</BaseLayout>
