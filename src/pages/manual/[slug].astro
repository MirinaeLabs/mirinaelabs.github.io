---
import ManualArticle from "../../components/ManualArticle.astro";
import { manualTopics, type ManualTopic } from "../../data/manual";

export function getStaticPaths() {
  return manualTopics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

interface Props { topic: ManualTopic }
const { topic } = Astro.props;
---
<ManualArticle locale="ko" topic={topic} />
